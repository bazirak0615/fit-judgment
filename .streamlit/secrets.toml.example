# Streamlit Cloud 배포 시 secrets.toml로 복사하고 값을 채우세요.
# 로컬 실행 시에는 환경변수로 대체 가능 (예: LLM_BACKEND=mock)

# ============================================================
#  LLM 백엔드 선택
# ============================================================
# "mock"   — Mock 모드 (LLM 호출 없음, 즉시 응답)
# "ollama" — 로컬 Ollama (qwen2.5:7b 등 사전 설치 필요)
# "anthropic" — Anthropic Claude API (향후 지원)

LLM_BACKEND = "mock"


# ============================================================
#  Mock 모드 옵션
# ============================================================
# Mock 응답에 인공 지연 추가 여부 (실제 추론처럼 보이게)
# MOCK_NO_DELAY = ""  # 값 있으면 지연 비활성


# ============================================================
#  실제 API 사용 시 (mock 외 모드)
# ============================================================
# ANTHROPIC_API_KEY = "sk-ant-..."
# OPENAI_API_KEY = "sk-..."
